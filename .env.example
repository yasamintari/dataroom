# Databricks Configuration
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token

# Databricks Unity Catalog Settings
DATABRICKS_CATALOG=yasamin_tari
DATABRICKS_SCHEMA=dataroom

# Model Configuration (Databricks Foundation Models)
# These are accessed via Databricks Model Serving endpoints
ANALYSIS_MODEL=databricks-dbrx-instruct
GENERAL_MODEL=databricks-meta-llama-3-1-70b-instruct
FAST_MODEL=databricks-mixtral-8x7b-instruct

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Vector Search Configuration
VECTOR_SEARCH_ENDPOINT=dataroom_vs_endpoint

# Processing Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# Optional: External LLM Provider API Keys
# Only needed if you set provider="openai|anthropic|google" in config.yaml
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
